# ── LLM Provider ──────────────────────────
# Uncomment and set the API key for your provider
# OPENROUTER_API_KEY=sk-or-v1-xxx
# ZHIPU_API_KEY=xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx
# MODELSCOPE_API_KEY=xxx
# CLAUDE_CODE_OAUTH=xxx
# ── Chat Channel ──────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC...
# DISCORD_BOT_TOKEN=xxx
# Feishu (飞书)
# CLAWY_CHANNELS_FEISHU_APP_ID=cli_xxx
# CLAWY_CHANNELS_FEISHU_APP_SECRET=xxx
# CLAWY_CHANNELS_FEISHU_RANDOM_REACTION_EMOJI=Typing,OneSecond

# ── Web Search (optional) ────────────────
# BRAVE_SEARCH_API_KEY=BSA...

# ── OpenTelemetry (optional) ─────────────
# Enable in config.json via "telemetry": {"enabled": true, ...} or with:
# CLAWY_TELEMETRY_ENABLED=true
# CLAWY_TELEMETRY_ENDPOINT=localhost:4317
# CLAWY_TELEMETRY_PROTOCOL=grpc            # or "http"
# CLAWY_TELEMETRY_SAMPLE_RATIO=1.0
# Standard OTEL_* variables are honored as fallbacks:
# OTEL_SERVICE_NAME=clawy
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20xxx

# ── Timezone ──────────────────────────────
TZ=Asia/Shanghai
